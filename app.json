{
  "expo": {
    "name": "TimeInamo",
    "slug": "timeinamo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F9FC",
    "scheme": "timeinamo",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.timeinamo.mobile"
    },
    "android": {
      "package": "app.timeinamo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F9FC"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
