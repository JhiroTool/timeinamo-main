{
  "expo": {
    "name": "TimeInamo",
    "slug": "timeinamo",
    "version": "1.0.0-beta.1",
    "icon": "./assets/images/TI ICON.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "scheme": "timeinamo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.timeinamo.mobile"
    },
    "android": {
      "package": "app.timeinamo.mobile",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/TI ICON.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/TI LOGO 432.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "02f33274-1094-47f8-829d-9f45b3075ec8"
      }
    },
    "owner": "accelvivas"
  }
}
