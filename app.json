{
  "expo": {
    "name": "TimeInamo",
    "slug": "timeinamo",
    "version": "0.1.0",
    "icon": "./assets/images/TI LOGO.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F9FC",
    "scheme": "timeinamo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.timeinamo.mobile"
    },
    "android": {
      "package": "app.timeinamo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/TI LOGO.png",
        "backgroundColor": "#F7F9FC"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
